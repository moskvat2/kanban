# Copie para .env.prod e ALTERE todos os segredos abaixo antes de usar em produção.
# Uso: cp .env.prod.example .env.prod && docker compose -f docker-compose.prod.yml up -d --build

# Banco de dados
MYSQL_DATABASE=kanban
MYSQL_USER=kanban
MYSQL_PASSWORD=TROQUE_POR_SENHA_FORTE
MYSQL_ROOT_PASSWORD=TROQUE_POR_SENHA_ROOT_FORTE

# JWT — gere com: openssl rand -hex 32
JWT_SECRET_KEY=TROQUE_POR_CHAVE_64_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cadastro aberto? Em produção recomendado false (usuários criados por admin/DB)
ALLOW_REGISTRATION=false

# Origem que vai consumir a API (domínio de produção)
CORS_ORIGINS=https://seu-dominio.com

# Porta do host para o frontend (nginx)
FRONTEND_PORT=80